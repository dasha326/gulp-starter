{
  "name": "gulp-starter",
  "description": "Starter for static frontend projects built with Gulp, Sass and esbuild.",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "^22.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    "defaults",
    "not dead",
    "not op_mini all",
    "not and_uc > 0",
    "not < 0.5%"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:dasha326/gulp-starter.git"
  },
  "license": "UNLICENSED",
  "scripts": {
    "clean": "gulp clean",
    "start": "gulp dev",
    "build": "gulp build",
    "styles": "gulp styles",
    "scripts": "gulp scripts",
    "lint": "npm run lint:styles && npm run lint:scripts && npm run build && npm run lint:html",
    "lint:fix": "eslint source/js gulpfile.js --fix && stylelint \"source/styles/**/*.scss\" --fix",
    "lint:html": "html-validator \"dist/**/*.html\" --quiet",
    "lint:styles": "stylelint \"source/styles/**/*.scss\"",
    "lint:scripts": "eslint source/js gulpfile.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.5.0",
    "browser-sync": "^3.0.4",
    "browserslist-to-esbuild": "^2.1.1",
    "cssnano": "^7.1.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "gulp": "^5.0.1",
    "gulp-esbuild": "^0.15.0",
    "gulp-file-include": "^2.3.0",
    "gulp-imagemin": "^9.2.0",
    "gulp-plumber": "1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-sass": "^6.0.1",
    "gulp-stacksvg": "^5.0.1",
    "gulp-webp": "^5.1.0",
    "postcss": "^8.5.6",
    "postcss-scss": "^4.0.9",
    "postcss-sort-media-queries": "^6.6.1",
    "sass": "^1.100.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "w3c-html-validator": "^2.2.1"
  }
}
